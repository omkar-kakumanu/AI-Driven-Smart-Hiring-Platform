# ==============================================================================
# AI Recruitment Copilot .gitignore Configuration
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production / Build
dist/
build/
*.jar
target/
.vite-temp/

# Python & Caching
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Streamlit Cache & State
.streamlit/
.streamlit/*.toml

# Audio & Temporary Media
*.wav
*.mp3
*.ogg
*.aac

# Databases & Backups
*.db
*.sqlite3
*.db-journal

# Environment Secrets
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
ai-service/.env
backend/.env
frontend/.env

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
